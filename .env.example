# Every SHC_* value is optional; defaults live in shc.config.Settings.
# Nested sections use a double underscore. Uncomment a line to override it.

# Console
# SHC_CONSOLE__WIDTH=120                  # terminal width if unset
# SHC_CONSOLE__HEIGHT=40                  # terminal height if unset
# SHC_CONSOLE__COLOR_SYSTEM=auto          # auto, standard, 256, truecolor, windows
# SHC_CONSOLE__NO_COLOR=false
# SHC_CONSOLE__FORCE_TERMINAL=true        # detected automatically if unset
# SHC_CONSOLE__QUIET=false
# SHC_CONSOLE__SOFT_WRAP=false
# SHC_CONSOLE__MARKUP=true
# SHC_CONSOLE__EMOJI=true
# SHC_CONSOLE__HIGHLIGHT=true
# SHC_CONSOLE__TAB_SIZE=8

# Logging
# SHC_LOG__LEVEL=INFO                     # DEBUG, INFO, WARNING, ERROR, CRITICAL
# SHC_LOG__CONSOLE_LEVEL=DEBUG
# SHC_LOG__FILE_LEVEL=INFO
# SHC_LOG__FORMAT=console                 # console or json; file logs are always JSON
# SHC_LOG__DIR=./logs                     # platform user log directory if unset
# SHC_LOG__FILE_NAME=shc.log
# SHC_LOG__FILE_MAX_BYTES=4194304
# SHC_LOG__FILE_BACKUP_COUNT=5

# Shortcuts
# SHC_SHORTCUTS__FILE=~/shortcuts.yml        # shortcuts.yml in the platform user config directory if unset
# SHC_SHORTCUTS__PLUGINS_DIR=~/shc-plugins   # plugins in the platform user config directory if unset
